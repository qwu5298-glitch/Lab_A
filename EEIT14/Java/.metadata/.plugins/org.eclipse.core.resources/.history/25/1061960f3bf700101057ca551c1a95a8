package tw.brad.servlet;

import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;

import java.awt.Color;
import java.awt.Font;
import java.awt.Graphics2D;
import java.awt.Image;
import java.awt.geom.AffineTransform;
import java.awt.image.BufferedImage;
import java.io.File;
import java.io.IOException;
import java.io.PrintWriter;

import javax.imageio.ImageIO;

@WebServlet("/Brad15")
public class Brad15 extends HttpServlet {
	protected void doGet(HttpServletRequest request, HttpServletResponse response) 
			throws ServletException, IOException {
		request.setCharacterEncoding("UTF-8");
		
		String source = "C:\\Users\\User\\eclipse-workspace\\BradWeb\\src\\main\\webapp\\upload\\forest.jpg";
		
		BufferedImage img = ImageIO.read(new File(source));
		Graphics2D g2d = img.createGraphics();
		
		AffineTransform transform = new AffineTransform();
		transform.rotate(Math.toRadians(30));
		
		g2d.setFont(new Font(null, Font.BOLD, 128));
		g2d.setColor(Color.BLUE);
		g2d.drawString("歡迎", 400, 400);
		
		
		response.setContentType("image/jpeg");
		ImageIO.write(img, "JPEG", response.getOutputStream());
		
		
		PrintWriter out = response.getWriter();
		
		response.flushBuffer();
	}

}