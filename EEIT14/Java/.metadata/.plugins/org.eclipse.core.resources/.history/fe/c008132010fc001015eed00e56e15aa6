<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>
<%@ taglib uri="jakarta.tags.sql" prefix="sql" %>
<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>Insert title here</title>
	</head>
	<body>
		<c:set var="rpp">10</c:set>
		<c:set var="page">${empty param.page?1:param.page }</c:set>
		<c:set var="start">${(page - 1) * rpp }</c:set>
		<c:set var="prev">10</c:set>
		<c:set var="next">10</c:set>
		
		
		<sql:query var="rs" dataSource="jdbc/mysql">
			SELECT * FROM food LIMIT ?, ?
		</sql:query>
		
		<h1>Brad Big Company</h1>
		<hr />
		<a href="">Prev</a> | Page: <span></span> | <a href="">Next</a>
		<hr />
		<table border="1" width="100%">
			<tr>
				<th>Name</th>
			</tr>
			<c:forEach items="${rs.rows }" var="food">
				<tr>
					<td>${food.name }</td>
				</tr>
			</c:forEach>
		</table>
	</body>
</html>