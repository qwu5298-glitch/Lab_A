			<thead>	
				<th>ID</th>
				<th>Name</th>
				<th>Tel</th>
				<th>Address</th>
			</thead>
			<tbody>
				<tr th:each="hotel : ${page.content}">
					<td th:text="${hotel}"></td>
					<td></td>
					<td></td>
					<td></td>
				</tr>
			</tbody>
		</table>
	</body>
</html>