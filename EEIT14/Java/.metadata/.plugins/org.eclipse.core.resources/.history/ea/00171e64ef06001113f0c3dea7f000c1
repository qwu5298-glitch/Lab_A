					})
					.done(result => {
						console.log(result);
					});
				}
				
				loadHotel(nowPage);
				
				$('#prev').click(() => {});
				$('#next').click(() => {});
				
			});
		</script>
	</head>
	<body>
		<h1 id="companyName">Title</h1>
		<h3 id="companyTel">Tel</h3>
		<h2>Main Page</h2>
		<hr />
		<div id="welcome"></div>
		<div id="icon"></div>
		<button id="logout">Logout</button>
		<hr />
		<button id="prev">Prev</button> | <span id="page">3</span> | <button id="next">Next</button>
